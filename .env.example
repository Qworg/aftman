# Credentials
#
# Either a TypeSafe key, or an OpenRouter key with TYPESAFE_BASE_URL set to
# https://openrouter.ai/api . The SDK-compatible env var names are used on purpose.
TYPESAFE_API_KEY=

# Optional overrides
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# TYPESAFE_DEFAULT_MODEL=jev-latest

# Worker backend: pi (default), agy, claude, generic, herdr:pane, simulated
# AFTMAN_WORKER=pi

# Worker permission posture: sandboxed (default), auto-approve, interactive.
# auto-approve additionally requires AFTMAN_ACK_UNSANDBOXED=1.
# AFTMAN_WORKER_PERMISSIONS=sandboxed

# Web surface
# AFTMAN_WEB_BIND=127.0.0.1:8787
# AFTMAN_WEB_TOKEN=

# Ensemble (see docs/06-ensemble.md). Off by default.
# AFTMAN_ENSEMBLE_ENABLED=false
# AFTMAN_ENSEMBLE_UNCERTAINTY_MARGIN=0.15
